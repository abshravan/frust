# ── InfluxDB v2 ──────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=my-super-secret-token
INFLUX_ORG=hospital
INFLUX_BUCKET=emotions

# Set to 1 to enable InfluxDB writes during batch processing.
ENABLE_INFLUX=0

# ── Optional Whisper ASR fusion ──────────────────────────────────────────────
ENABLE_WHISPER=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
