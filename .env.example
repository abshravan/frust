# ── GPU / device ─────────────────────────────────────────────────────────────
# Force a specific device: cuda:0 | cuda:1 | mps | cpu
# Leave blank for auto-detection (CUDA → MPS → CPU).
EMOTION_DEVICE=

# Segments processed per GPU batch. Larger = faster but more VRAM.
# Defaults: 16 on GPU/MPS, 4 on CPU.
EMOTION_BATCH_SIZE=

# ── InfluxDB v2 ──────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=my-super-secret-token
INFLUX_ORG=hospital
INFLUX_BUCKET=emotions

# Set to 1 to enable InfluxDB writes during batch processing.
ENABLE_INFLUX=0

# ── Optional Whisper ASR fusion ──────────────────────────────────────────────
ENABLE_WHISPER=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
